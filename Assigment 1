      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "url = 'https://raw.githubusercontent.com/CunyLaguardiaDataAnalytics/datasets/master/311_Service_Requests_from_2019May.csv'\n",
        "df = pd.read_csv(url, low_memory=False)\n",
        "df.head()"
      ],
      "id": "_mXcNjAYvqMg"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "gtae8XxAvqMi"
      },
      "source": [
        "## 1. How many rows and columns are in the dataset?"
      ],
      "id": "gtae8XxAvqMi"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "3ezj_XzlvqMj"
      },
      "outputs": [],
      "source": [
        "rows, columns = df.shape\n",
        "print(f'Rows: {rows:,}')\n",
        "print(f'Columns: {columns}')"
      ],
      "id": "3ezj_XzlvqMj"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "EN-6pXB2vqMj"
      },
      "source": [
        "## 2. What is the time range of the dataset?"
      ],
      "id": "EN-6pXB2vqMj"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "HrShKKvovqMj"
      },
      "outputs": [],
      "source": [
        "df['Created Date'] = pd.to_datetime(df['Created Date'])\n",
        "print('Earliest request:', df['Created Date'].min())\n",
        "print('Latest request:', df['Created Date'].max())"
      ],
      "id": "HrShKKvovqMj"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "0GQZTprZvqMk"
      },
      "source": [
        "## 3. Relevant summary statistics"
      ],
      "id": "0GQZTprZvqMk"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "_IV9HcdxvqMk"
      },
      "outputs": [],
      "source": [
        "print('Missing values in selected columns:')\n",
        "display(df[['Created Date', 'Borough', 'Complaint Type', 'Agency']].isna().sum())\n",
        "\n",
        "print('Most common complaint types:')\n",
        "display(df['Complaint Type'].value_counts().head(10))\n",
        "\n",
        "print('Requests by agency:')\n",
        "display(df['Agency'].value_counts().head(10))"
      ],
      "id": "_IV9HcdxvqMk"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "DDPYkx-xvqMl"
      },
      "source": [
        "## 4. Visualizations"
      ],
      "id": "DDPYkx-xvqMl"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "__uZHLASvqMl"
      },
      "outputs": [],
      "source": [
        "df['Complaint Type'].value_counts().head(10).sort_values().plot(kind='barh', figsize=(9, 6))\n",
        "plt.title('Top 10 NYC 311 Complaint Types')\n",
        "plt.xlabel('Number of Complaints')\n",
        "plt.ylabel('Complaint Type')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "__uZHLASvqMl"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "wpL_GqgBvqMl"
      },
      "outputs": [],
      "source": [
        "valid_boroughs = df.loc[~df['Borough'].isin(['Unspecified']), 'Borough'].dropna()\n",
        "valid_boroughs.value_counts().plot(kind='bar', figsize=(8, 5))\n",
        "plt.title('NYC 311 Complaints by Borough')\n",
        "plt.xlabel('Borough')\n",
        "plt.ylabel('Number of Complaints')\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "wpL_GqgBvqMl"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "apv0WhdAvqMl"
      },
      "outputs": [],
      "source": [
        "daily_counts = df.set_index('Created Date').resample('D').size()\n",
        "daily_counts.plot(kind='line', marker='o', figsize=(10, 5))\n",
        "plt.title('Daily NYC 311 Complaint Counts')\n",
        "plt.xlabel('Date')\n",
        "plt.ylabel('Number of Complaints')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "apv0WhdAvqMl"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "SNOdwJU8vqMm"
      },
      "source": [
        "## 5. What borough has the most complaints?"
      ],
      "id": "SNOdwJU8vqMm"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "4whvzEElvqMm"
      },
      "outputs": [],
      "source": [
        "borough_counts = valid_boroughs.value_counts()\n",
        "print(f'The borough with the most complaints is {borough_counts.idxmax()} with {borough_counts.max():,} complaints.')"
      ],
      "id": "4whvzEElvqMm"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-tGs4H7uvqMm"
      },
      "source": [
        "## 6. Plot of counts by borough for noise complaints"
      ],
      "id": "-tGs4H7uvqMm"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mi47zBWJvqMm"
      },
      "outputs": [],
      "source": [
        "noise = df[df['Complaint Type'].str.contains('Noise', case=False, na=False)]\n",
        "noise_borough_counts = noise.loc[~noise['Borough'].isin(['Unspecified']), 'Borough'].dropna().value_counts()\n",
        "noise_borough_counts.plot(kind='bar', figsize=(8, 5))\n",
        "plt.title('Noise Complaints by Borough')\n",
        "plt.xlabel('Borough')\n",
        "plt.ylabel('Number of Noise Complaints')\n",
        "plt.xticks(rotation=45)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "mi47zBWJvqMm"
    },
